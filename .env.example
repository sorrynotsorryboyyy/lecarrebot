# ─── CarréBot — Variables d'environnement ───────────────────────────
# Copie ce fichier en `.env` pour le développement local.
# Sur Railway, ajoute ces variables dans l'onglet "Variables" du service.

# Token du bot (Discord Developer Portal > ton app > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant)
# Nécessite le Mode Développeur : Paramètres > Avancés > Mode développeur
GUILD_ID=

# Connexion PostgreSQL.
# Railway, base dans LE MÊME projet que le bot : ${{Postgres.DATABASE_URL}}
# Railway, base dans un AUTRE projet : colle ici DATABASE_PUBLIC_URL
#   (le réseau privé *.railway.internal ne traverse pas les projets)
DATABASE_URL=

# Optionnel — URL publique de secours. Si DATABASE_URL pointe vers le réseau
# privé et que celui-ci est injoignable, le bot bascule automatiquement ici.
DATABASE_PUBLIC_URL=

# Optionnel — niveau de log : debug | info | warn | error  (défaut: info)
LOG_LEVEL=info

# ─── Statistiques CS2 (facultatif) ──────────────────────────────────
# Sans ces clés, le bot démarre et fonctionne normalement : seule la
# commande /lier répond que la source n'est pas configurée.

# Faceit — niveau, Elo, K/D, winrate.
# Clé gratuite : https://developers.faceit.com > créer une app > API Key (server-side)
FACEIT_API_KEY=

# Steam — heures de jeu et statistiques CS2.
# Clé gratuite : https://steamcommunity.com/dev/apikey
# Note : le membre doit avoir « Détails du jeu » en public sur son profil.
STEAM_API_KEY=
